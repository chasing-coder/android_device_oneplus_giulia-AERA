From f2d30a57346b76310cd230815b887fb500c08b3e Mon Sep 17 00:00:00 2001
From: cheng343 <203324649+cheng343@users.noreply.github.com>
Date: Fri, 16 Oct 2026 22:36:07 +0800
Subject: [PATCH 5/8] plugins: bound every store download with a deadline

The store worker waited for the completion pipe only. Recovery installs a
process wide SIGCHLD handler that can reap wget first, and every other fork in
the process inherits the pipe's write end, so a stalled transfer - or the
automatic update check that starts on its own as soon as Wi-Fi comes up - left
the worker parked forever and the Plugins page stuck on its progress view with
no way out but a reboot.

Make the child itself the authority for completion (waitpid WNOHANG, with
ECHILD treated as a child the handler already recovered), keep a per attempt
deadline that scales with the download size, kill the child when it expires,
honour progress->cancel, and report a stalled or cancelled transfer instead of
waiting two more identical rounds.

Tested on the host against the real function body: before this change the code
parks in all six scenarios (held open pipe, stalled transfer, recovered child,
failing wget, cancelled download, happy path); after it the worker returns in
all of them, kills the child on stall and cancel, and still succeeds on the
happy path.
---
 aeraui/features/plugins/plugin_manager.cpp | 93 +++++++++++++++++++---
 1 file changed, 80 insertions(+), 13 deletions(-)

diff --git a/aeraui/features/plugins/plugin_manager.cpp b/aeraui/features/plugins/plugin_manager.cpp
index 3fd64cd..9f4a9b4 100644
--- a/aeraui/features/plugins/plugin_manager.cpp
+++ b/aeraui/features/plugins/plugin_manager.cpp
@@ -12,6 +12,7 @@
 #include <array>
 #include <cerrno>
 #include <cctype>
+#include <csignal>
 #include <cstdio>
 #include <cstring>
 #include <dirent.h>
@@ -26,6 +27,7 @@
 #include <sys/stat.h>
 #include <sys/types.h>
 #include <sys/wait.h>
+#include <time.h>
 #include <unistd.h>
 #include <ziparchive/zip_archive.h>
 
@@ -45,6 +47,17 @@ constexpr uint64_t kMaxManifest = 64 * 1024;
 constexpr uint64_t kMaxSignature = 4096;
 constexpr uint64_t kMaxPayload = 512ULL * 1024 * 1024;
 constexpr uint64_t kMaxPackage = kMaxPayload + 1024 * 1024;
+// Every other downloader in the recovery already puts a deadline on its wget
+// child (root_manager.cpp, update_manager.cpp). The store's own downloader
+// only waited for the completion pipe, which is not authoritative: every other
+// fork in this process inherits the write end, so one stalled transfer - or
+// one long lived sibling such as the update check that starts as soon as Wi-Fi
+// comes up - keeps the store worker, and the page waiting on it, parked
+// forever. Keep a per attempt deadline and kill the child when it expires.
+constexpr uint64_t kMaxQuickPayload = 32ULL * 1024 * 1024;
+constexpr uint64_t kDownloadQuickMilliseconds = 30000;
+constexpr uint64_t kDownloadAssetMilliseconds = 120000;
+constexpr uint64_t kDownloadPayloadMilliseconds = 600000;
 constexpr std::array<uint8_t, 32> kSigningKey{{
     0x16, 0xee, 0x36, 0x7d, 0xd2, 0xd7, 0xae, 0x19,
     0xa0, 0xd1, 0x62, 0xfb, 0x71, 0x66, 0xe0, 0xf7,
@@ -405,7 +418,9 @@ bool Download(const std::string &url, const std::string &path, uint64_t limit,
 
     // Recovery installs a process-wide SIGCHLD handler which may reap wget
     // before this worker reaches waitpid(). Keep a pipe descriptor inherited
-    // across exec instead: EOF is delivered only after wget really exits.
+    // across exec as a liveness hint - it is not the completion signal, since
+    // every other fork holds a copy of the write end and a stalled transfer
+    // would leave it open indefinitely.
     int completion[2];
     if (pipe(completion) != 0) return false;
     const pid_t child = fork();
@@ -443,12 +458,44 @@ bool Download(const std::string &url, const std::string &path, uint64_t limit,
       progress->total_bytes.store(expected_size);
       progress->value.store(progress_start);
     }
+    const uint64_t timeout_ms = limit <= kMaxCatalog
+        ? kDownloadQuickMilliseconds
+        : (limit <= kMaxQuickPayload ? kDownloadAssetMilliseconds
+                                     : kDownloadPayloadMilliseconds);
     pollfd completion_event{completion[0], POLLIN | POLLHUP, 0};
-    for (;;) {
+    timespec started{};
+    clock_gettime(CLOCK_MONOTONIC, &started);
+    int status = 0;
+    bool reaped = false;
+    bool timed_out = false;
+    while (!timed_out && !(progress && progress->cancel.load())) {
       const int result = poll(&completion_event, 1, 100);
-      if (result < 0 && errno == EINTR) continue;
-      if (result < 0 || (completion_event.revents & (POLLHUP | POLLERR | POLLNVAL)))
+      if (result < 0 && errno != EINTR) {
+        // A descriptor that stopped being pollable must not turn the deadline
+        // below into a busy loop.
+        poll(nullptr, 0, 100);
+      }
+
+      // The child itself is the authoritative completion signal, not the pipe:
+      // recovery's SIGCHLD handler may already have reaped wget (ECHILD), and
+      // any other fork in this process holds a copy of the write end, so EOF
+      // can arrive long after wget exited - or never.
+      pid_t waited;
+      do {
+        waited = waitpid(child, &status, WNOHANG);
+      } while (waited < 0 && errno == EINTR);
+      if (waited == child) {
+        reaped = true;
+        break;
+      }
+      if (waited < 0 && errno == ECHILD) {
+        // Already reaped by that handler: the payload checks below are the
+        // only evidence left, exactly as before.
+        reaped = true;
+        status = 0;
         break;
+      }
+
       if (progress && expected_size) {
         struct stat partial{};
         if (lstat(path.c_str(), &partial) == 0 && S_ISREG(partial.st_mode) &&
@@ -461,19 +508,37 @@ bool Download(const std::string &url, const std::string &path, uint64_t limit,
               static_cast<unsigned>(bytes * span / expected_size));
         }
       }
+
+      timespec now{};
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      const int64_t elapsed =
+          static_cast<int64_t>(now.tv_sec - started.tv_sec) * 1000 +
+          static_cast<int64_t>(now.tv_nsec - started.tv_nsec) / 1000000;
+      if (elapsed >= static_cast<int64_t>(timeout_ms)) timed_out = true;
     }
-    close(completion[0]);
 
-    int status = 0;
-    pid_t waited;
-    do {
-      waited = waitpid(child, &status, 0);
-    } while (waited < 0 && errno == EINTR);
+    if (!reaped) {
+      kill(child, SIGKILL);
+    }
+    close(completion[0]);
+    if (!reaped) {
+      pid_t waited;
+      do {
+        waited = waitpid(child, &status, 0);
+      } while (waited < 0 && errno == EINTR);
+      if (waited != child) status = 0;
+    }
+    const bool cancelled = progress && progress->cancel.load();
+    if (timed_out || cancelled) {
+      fprintf(stderr, "AERA plugins: download of %s %s after %llu ms\n",
+              url.c_str(), cancelled ? "cancelled" : "stalled",
+              static_cast<unsigned long long>(timeout_ms));
+    }
     const bool exited_ok =
-        (waited == child && WIFEXITED(status) && WEXITSTATUS(status) == 0) ||
-        (waited < 0 && errno == ECHILD);
+        reaped && WIFEXITED(status) && WEXITSTATUS(status) == 0;
     struct stat info{};
-    if (exited_ok && lstat(path.c_str(), &info) == 0 && S_ISREG(info.st_mode) &&
+    if (exited_ok && !timed_out && !cancelled &&
+        lstat(path.c_str(), &info) == 0 && S_ISREG(info.st_mode) &&
         info.st_size > 0 && static_cast<uint64_t>(info.st_size) <= limit) {
       if (progress && expected_size) {
         progress->downloaded_bytes.store(static_cast<uint64_t>(info.st_size));
@@ -481,6 +546,8 @@ bool Download(const std::string &url, const std::string &path, uint64_t limit,
       }
       return true;
     }
+    // A stalled or cancelled attempt is not worth two more identical waits.
+    if (timed_out || cancelled) break;
   }
   unlink(path.c_str());
   return false;
