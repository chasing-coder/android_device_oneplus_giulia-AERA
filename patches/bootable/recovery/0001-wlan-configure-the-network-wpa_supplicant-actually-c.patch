From f19c18ac0236904e6ce396804922b820a1681e6b Mon Sep 17 00:00:00 2001
From: cheng343 <203324649+cheng343@users.noreply.github.com>
Date: Fri, 16 Oct 2026 12:45:03 +0800
Subject: [PATCH 1/8] wlan: configure the network wpa_supplicant actually
 created

Connect() dropped the id returned by ADD_NETWORK and then addressed network 0
for SET_NETWORK/ENABLE_NETWORK/SELECT_NETWORK. wpa_supplicant never reuses an
id, so once a previous attempt (or a saved network) had taken id 0, every later
command addressed a network that did not exist. The FAIL reply was
indistinguishable from success - both the control transport and the wpa_cli
fallback report it as success - so the only symptom was a bare "association
failed" after twelve 1.5s waits, with nothing in /tmp/recovery.log explaining
it. On-device logs show the supplicant sitting in SCANNING/DISCONNECTED and
never entering AUTHENTICATING: it was never asked to associate at all.

* use the id returned by ADD_NETWORK for every network command
* remove every stale entry of the target SSID, not only network 0
* verify the SSID with GET_NETWORK before waiting for an association
* treat FAIL/FAIL-BUSY/UNKNOWN COMMAND as failure in SuppCmd and log the
  rejected command together with the supplicant's answer
* dump STATUS and LIST_NETWORKS when the association wait fails
* dump /tmp/dhcptool.log when dhcptool fails (it used to return silently)
---
 wlan.cpp | 176 ++++++++++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 148 insertions(+), 28 deletions(-)

diff --git a/wlan.cpp b/wlan.cpp
index ef51095..5a8b125 100644
--- a/wlan.cpp
+++ b/wlan.cpp
@@ -142,6 +142,32 @@ static std::string HexEncode(const std::string& value) {
     return encoded;
 }
 
+/*
+ * wpa_supplicant answers every control command, including rejections, and the
+ * control transport hands that answer back verbatim: a bare "FAIL" means the
+ * command did NOT take effect. wpa_cli exits 0 in that case as well, so the
+ * reply itself has to decide. Without this check a rejected SET_NETWORK is
+ * indistinguishable from a configured network, and the only symptom left is a
+ * generic "association failed" roughly eighteen seconds later.
+ */
+static bool SupplicantRejected(const std::string& reply) {
+    size_t start = 0;
+    size_t end = reply.size();
+    while (start < end && std::isspace(static_cast<unsigned char>(reply[start])))
+        ++start;
+    while (end > start && std::isspace(static_cast<unsigned char>(reply[end - 1])))
+        --end;
+
+    const std::string trimmed = reply.substr(start, end - start);
+    /*
+     * Match the exact rejection tokens instead of a "FAIL" prefix: replies to
+     * data commands (GET_NETWORK, LIST_NETWORKS, SCAN_RESULTS) can legitimately
+     * begin with the same letters when an SSID does.
+     */
+    return trimmed == "FAIL" || trimmed == "FAIL-BUSY" ||
+           trimmed == "UNKNOWN COMMAND" || trimmed.rfind("FAIL\n", 0) == 0;
+}
