         DataManager::SetValue("tw_wlan_connected", 0);
@@ -1285,6 +1526,262 @@ bool Wlan::StartSupplicant() {
     return StartInitSupplicantService();
 }
 
+namespace {
+// True for the file names the QCA driver may load from its chip directory: the
+// ELF/segmented board data, the regulatory database, and the NV config.
+bool IsWlanBoardDataName(const std::string& name) {
+    if (name.compare(0, 7, "bdwlan.") == 0)
+        return true;
+    if (name == "regdb.bin" || name == "regdb_version" || name == "bin_version")
+        return true;
+    if (name == "WCNSS_qcom_cfg.ini")
+        return true;
+    /* Deterministic MAC written by PrepareStableMacFirmware(). */
+    if (name == "wlan_mac.bin")
+        return true;
+    return false;
+}
+
+// Comma-separated list for the log lines; the set stays small.
+std::string JoinNames(const std::set<std::string>& names) {
+    std::string joined;
+    for (std::set<std::string>::const_iterator it = names.begin(); it != names.end(); ++it) {
+        if (!joined.empty())
+            joined += ",";
+        joined += *it;
+    }
+    return joined;
+}
+
+// Collects one directory level of `root` into `names`. Missing roots are fine.
+void CollectSubdirs(const std::string& root, std::set<std::string>& names) {
+    DIR* dir = opendir(root.c_str());
+    if (!dir)
+        return;
+
+    while (struct dirent* entry = readdir(dir)) {
+        const std::string name = entry->d_name;
+        if (name.empty() || name[0] == '.')
+            continue;
+        names.insert(name);
+    }
+    closedir(dir);
+}
+}  // namespace
+
+/*
+ * Keeps the driver's firmware load inside the ramdisk.
+ *
+ * Under recovery the kernel domain cannot traverse the vfat modem mount, so the
+ * firmware_class `path` override in init.recovery.qcom.rc points the loader at
+ * the ramdisk (/vendor/firmware). Whatever the chip asks for therefore has to
+ * be copied out of the modem image by userspace first — and the copies bundled
+ * in this device tree use the Waffle-era directory name "kiwi" while the device
+ * itself reports "kiwi_v2". The payload is copied exactly once and every other
+ * spelling is a symlink to it, so the ramdisk grows by a single copy.
+ *
+ * The device's own board data is also per-unit: the modem image carries the
+ * segmented bdwlan.e01..bdwlan.e3d set for the eFuse revisions, while the tree
+ * only bundles the generic bdwlan.b0c/bdwlan.elf copies. A driver that cannot
+ * find the calibration matching its eFuse quietly falls back to the generic
+ * image, which is enough to scan but not enough to associate.
+ */
+bool Wlan::StageDriverFirmware() {
+    // The vendor fstab mount lives on the modem partition; bring it up if the
+    // init trigger has not run yet. Userspace may read that mount even though
+    // the kernel firmware loader may not.
+    if (!FileExists(WLAN_FIRMWARE_IMAGE_ROOT) && FileExists(WLAN_MODEM_PARTITION)) {
+        char slot[PROPERTY_VALUE_MAX] = {0};
+        property_get("ro.boot.slot_suffix", slot, "");
+        if (RunCommand(std::string("mkdir -p ") + WLAN_MODEM_MOUNT + " && mount vfat " +
+                       WLAN_MODEM_PARTITION + slot + " " + WLAN_MODEM_MOUNT + " ro"))
+            LOGINFO("WLAN: mounted the modem image at %s\n", WLAN_MODEM_MOUNT);
+    }
+
+    const std::vector<std::string> source_roots = {
+        WLAN_FIRMWARE_IMAGE_ROOT,
+        std::string(WLAN_MODEM_MOUNT) + "/image",
+        "/odm/etc/wifi",
+        "/vendor/odm/etc/wifi",
+        "/vendor/etc/wifi",
+        "/vendor/odm/firmware",
+    };
+
+    // Chip directory names to serve: everything a source exposes, the module
+    // name the driver registered (qca_cld3_kiwi_v2 -> kiwi_v2), and the
+    // fallback spelling the bundled copies use.
+    std::set<std::string> chips;
+    chips.insert(WLAN_CHIP_FALLBACK);
+    chips.insert(WLAN_CHIP_ALIAS);
+
+    DIR* modules = opendir("/sys/module");
+    if (modules) {
+        while (struct dirent* entry = readdir(modules)) {
+            const std::string name = entry->d_name;
+            const std::string prefix = "qca_cld3_";
+            if (name.compare(0, prefix.size(), prefix) == 0 && name.size() > prefix.size())
+                chips.insert(name.substr(prefix.size()));
+        }
+        closedir(modules);
+    }
+
+    for (size_t i = 0; i < source_roots.size(); ++i) {
+        std::set<std::string> names;
+        CollectSubdirs(source_roots[i], names);
+
+        for (std::set<std::string>::const_iterator it = names.begin(); it != names.end(); ++it) {
+            const std::string dir = source_roots[i] + "/" + *it;
+            if (FileExists(dir + "/bdwlan.elf") || FileExists(dir + "/bdwlan.b0c") ||
+                FileExists(dir + "/regdb.bin"))
+                chips.insert(*it);
+        }
+    }
+
+    // One source per file name, most authoritative first: the device's own
+    // modem image beats the odm copies, which beat the bundled ramdisk ones.
+    std::map<std::string, std::string> chosen;
+    for (size_t i = 0; i < source_roots.size(); ++i) {
+        for (std::set<std::string>::const_iterator chip = chips.begin(); chip != chips.end(); ++chip) {
+            const std::string dir = source_roots[i] + "/" + *chip;
+            DIR* dh = opendir(dir.c_str());
+            if (!dh)
+                continue;
+
+            while (struct dirent* entry = readdir(dh)) {
+                const std::string name = entry->d_name;
+                if (!IsWlanBoardDataName(name))
+                    continue;
+                if (chosen.find(name) == chosen.end()) {
+                    chosen[name] = dir + "/" + name;
+                    gui_print("WLAN: board data %s <- %s\n", name.c_str(), chosen[name].c_str());
+                }
+            }
+            closedir(dh);
+        }
+    }
+
+    if (chosen.empty()) {
+        LOGERR("WLAN: no board data found (chip names tried: %s, looked under %s and the odm/ramdisk copies)\n",
+               JoinNames(chips).c_str(), WLAN_FIRMWARE_IMAGE_ROOT);
+        return false;
+    }
+
+    // Canonical store: <firmware root>/<first chip name>, alphabetically first
+    // so the modem image's own spelling wins.
+    const std::string store = std::string(WLAN_FIRMWARE_ROOT) + "/" + *chips.begin();
+    if (!MkdirRecursive(store))
+        return false;
+
+    size_t staged_bytes = 0;
+    size_t staged_files = 0;
+    bool capped = false;
+
+    for (std::map<std::string, std::string>::const_iterator it = chosen.begin();
+         it != chosen.end(); ++it) {
+        std::string payload;
+        if (!ReadFile(it->second, payload))
+            continue;
+        if (staged_bytes + payload.size() > WLAN_BOARD_DATA_MAX_BYTES) {
+            capped = true;
+            continue;
+        }
+        if (!WriteFile(store + "/" + it->first, payload))
+            continue;
+
+        staged_bytes += payload.size();
+        ++staged_files;
+    }
+
+    if (staged_files == 0) {
+        LOGERR("WLAN: board data could not be staged into %s\n", store.c_str());
+        return false;
+    }
+
+    /*
+     * Every other directory spelling: the remaining chip names, both loader
+     * spellings under the firmware root ("<chip>" and "image/<chip>"), the
+     * qca_cld config directory the driver reads NV items from, and the etc/wifi
+     * copy PrepareStableMacFirmware() scans for WCNSS_qcom_cfg.ini.
+     */
+    const std::vector<std::string> alias_dirs = {
+        std::string(WLAN_FIRMWARE_ROOT) + "/image",
+        std::string(WLAN_FIRMWARE_ROOT) + "/wlan/qca_cld",
+        "/vendor/etc/wifi",
+        "/vendor/odm/firmware",
+    };
+
+    // A real directory at an alias path (the bundled copies use the old chip
+    // name) must be merged into the store before the link replaces it: deleting
+    // it outright would throw away board data this run did not pick up.
+    const auto MergeIntoStore = [](const std::string& from, const std::string& to) {
+        DIR* dh = opendir(from.c_str());
+        if (!dh)
+            return;
+
+        while (struct dirent* entry = readdir(dh)) {
+            const std::string name = entry->d_name;
+            if (name.empty() || name[0] == '.')
+                continue;
+
+            const std::string dst = to + "/" + name;
+            if (FileExists(dst))
+                continue;
+
+            std::string payload;
+            if (!ReadFile(from + "/" + name, payload))
+                continue;
+            if (WriteFile(dst, payload))
+                gui_print("WLAN: kept bundled board data %s\n", name.c_str());
+        }
+        closedir(dh);
+    };
+
+    // Points `link` at `target`, replacing whatever is there: a real directory
+    // (the bundled Waffle copies use the old chip name) would otherwise swallow
+    // the link and create it one level too deep.
+    const auto Relink = [&MergeIntoStore](const std::string& target, const std::string& link) {
+        char resolved[4096] = {0};
+        const ssize_t got = readlink(link.c_str(), resolved, sizeof(resolved) - 1);
+        if (got > 0 && std::string(resolved, static_cast<size_t>(got)) == target)
+            return;
+
+        if (symlink(target.c_str(), link.c_str()) == 0)
+            return;
+
+        if (errno != EEXIST) {
+            LOGERR("WLAN: cannot link %s -> %s: %s\n", link.c_str(), target.c_str(),
+                   strerror(errno));
+            return;
+        }
+
+        MergeIntoStore(link, target);
+        Wlan::RunCommand("rm -rf " + link);
+        if (symlink(target.c_str(), link.c_str()) != 0)
+            LOGERR("WLAN: cannot link %s -> %s: %s\n", link.c_str(), target.c_str(),
+                   strerror(errno));
+    };
+
+    for (std::set<std::string>::const_iterator chip = chips.begin(); chip != chips.end(); ++chip) {
+        for (size_t i = 0; i < alias_dirs.size(); ++i) {
+            const std::string link = alias_dirs[i] + "/" + *chip;
+            if (link == store)
+                continue;
+            MkdirRecursive(alias_dirs[i]);
+            Relink(store, link);
+        }
+    }
+
+    // A bare request ("bdwlan.elf") resolves against the firmware root itself.
+    for (std::map<std::string, std::string>::const_iterator it = chosen.begin();
+         it != chosen.end(); ++it)
+        Relink(store + "/" + it->first, std::string(WLAN_FIRMWARE_ROOT) + "/" + it->first);
+
+    gui_print("WLAN: staged %zu board-data file(s) (%zu bytes) into %s; chip names: %s%s\n",
+              staged_files, staged_bytes, store.c_str(), JoinNames(chips).c_str(),
+              capped ? " (payload capped)" : "");
+    return true;
+}
