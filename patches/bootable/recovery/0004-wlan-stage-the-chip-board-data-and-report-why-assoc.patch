     }
 
     if (!completed) {
@@ -596,6 +816,27 @@ bool Wlan::Connect() {
         if (SuppCmd("LIST_NETWORKS", failure_networks))
             gui_print("WLAN: LIST_NETWORKS after failure:\n%s\n",
                       failure_networks.c_str());
+
+        /*
