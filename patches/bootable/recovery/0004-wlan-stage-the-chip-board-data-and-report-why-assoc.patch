From c76c95b878e5e2e7c6b5f7172d8d792b1feff41a Mon Sep 17 00:00:00 2001
From: cheng343 <203324649+cheng343@users.noreply.github.com>
Date: Fri, 16 Oct 2026 18:56:50 +0800
Subject: [PATCH] wlan: stage the chip board data and report why an association
 fails

Recovery boots with the kernel firmware loader pointed at the ramdisk
(firmware_class.path=/vendor/firmware) because the modem vfat mount cannot
be traversed from the kernel domain under recovery SELinux. The board data
this device's WLAN driver needs (bdwlan*, regdb*) only exists on that modem
image, and the ramdisk ships the Waffle-era chip directory name "kiwi" while
the device reports "kiwi_v2" - so the driver came up without its board data
and every association attempt died without a single line of explanation.

The device's own board data is also per-unit: the modem image carries the
segmented bdwlan.e01..bdwlan.e3d set for the eFuse revisions while the tree
bundles only the generic bdwlan.b0c/bdwlan.elf copies. A driver that cannot
find the calibration matching its eFuse quietly falls back to the generic
image - enough to scan, not enough to associate.

* StageDriverFirmware() copies the chip's board data out of the modem image
  (mounting it first when boot has not) into the directory spellings the
  driver probes, serving both "kiwi" and "kiwi_v2" and reading the payload
  from /vendor/firmware_mnt/image and /firmware/image alike. Called from
  Init() and Enable() so a late mount is still covered.
* A stale real directory at an alias path is merged into the canonical store
  before the symlink replaces it, so a bundled payload is never deleted.
* Connect() scans first, pins the BSS the selected SSID is actually
  visible on, asks for PMF explicitly, and retries without the pin when
  the pinned attempt fails.
* A failed association now dumps STATUS, LIST_NETWORKS, GET_NETWORK and
  the SSID's SCAN_RESULTS rows plus the WLAN lines of the kernel ring
  buffer, so the next report carries the driver's own verdict.
---
 wlan.cpp | 543 ++++++++++++++++++++++++++++++++++++++++++++++++++++---
 wlan.hpp |  21 +++
 2 files changed, 541 insertions(+), 23 deletions(-)

diff --git a/wlan.cpp b/wlan.cpp
index 5a8b125..b63e749 100644
--- a/wlan.cpp
+++ b/wlan.cpp
@@ -5,6 +5,7 @@
 #include <cstdint>
 #include <cerrno>
 #include <cstdio>
+#include <cstdlib>
 #include <cstring>
 #include <dirent.h>
 #include <fstream>
@@ -71,6 +72,29 @@ static constexpr int WLAN_SUPP_READY_TIMEOUT_MS = 60000;
  * wrapper (mondrian_wlan_up.sh); it is now native init builtins. */
 static const char* WLAN_SUPP_PREP_PROP = "sys.aera.wlan.up";
 
+/* Board data used by the QCA driver. The tree bundles Waffle-era copies under
+ * the chip directory "kiwi" (recovery/root/vendor/etc/wifi/kiwi and
+ * recovery/root/vendor/odm/firmware/kiwi), but this device reports the chip as
+ * "kiwi_v2" and keeps its authoritative copies on the modem partition, which
+ * the kernel firmware loader cannot reach under recovery SELinux (see the
+ * firmware_class `path` override in init.recovery.qcom.rc). Wlan::Init() copies
+ * the payload into the ramdisk before the driver asks for it. */
+static const char* WLAN_MODEM_PARTITION     = "/dev/block/bootdevice/by-name/modem";
+static const char* WLAN_FIRMWARE_IMAGE_ROOT = "/vendor/firmware_mnt/image";
+/* The init trigger mounts the modem image at /firmware and only links it to
+ * /vendor/firmware_mnt afterwards; staging may well run before that link. */
+static const char* WLAN_MODEM_MOUNT         = "/firmware";
+static const char* WLAN_CHIP_FALLBACK       = "kiwi";
+/* The vendor tree loads qca_cld3_kiwi_v2, so the chip directory can be spelled
+ * either way. Serve both spellings instead of guessing which one the driver
+ * asks the firmware loader for. */
+static const char* WLAN_CHIP_ALIAS          = "kiwi_v2";
+/* firmware_class resolves relative requests here, so both "<chip>/..." and
+ * "image/<chip>/..." spellings have to exist as well. */
+static const char* WLAN_FIRMWARE_ROOT       = "/vendor/firmware";
+/* Refuse to balloon the ramdisk if a vendor tree ships an unusually fat set. */
+static constexpr size_t WLAN_BOARD_DATA_MAX_BYTES = 24 * 1024 * 1024;
+
 static int HexDigitValue(char value) {
     if (value >= '0' && value <= '9') return value - '0';
     if (value >= 'a' && value <= 'f') return value - 'a' + 10;
@@ -206,6 +230,11 @@ static bool OF_GetEncryptedSavedSsids(std::vector<std::string>& ssids)
 }
 
 bool Wlan::Init() {
+    // The chip only loads board data that exists inside the ramdisk; stage it
+    // before the driver (and the MAC preparation below) looks for it.
+    if (!StageDriverFirmware())
+        LOGERR("WLAN: driver board data was not staged; bundled copies remain\n");
+
     // Qualcomm selects the interface MAC while the WLAN module is loading.
     // Prepare its config and firmware file now, before post-decrypt modules
     // create wlan0. Runtime SIOCSIFHWADDR is rejected by newer QCA drivers.
@@ -229,6 +258,11 @@ bool Wlan::Enable() {
     std::lock_guard<std::recursive_mutex> op(g_wlan_op_mutex);
     EnsureTmpLayout();
 
+    // The modem image is mounted by the time the user enables Wi-Fi, so this is
+    // the last chance to get the device's own board data into the ramdisk
+    // before the driver powers the chip up.
+    StageDriverFirmware();
+
     if (!StartSupplicant()) {
         DataManager::SetValue("tw_wlan_enabled", 0);
         DataManager::SetValue("tw_wlan_connected", 0);
@@ -330,6 +364,165 @@ bool Wlan::Scan() {
     return false;
 }
 
+namespace {
+std::string TrimSpaces(const std::string& s) {
+    size_t start = 0;
+    while (start < s.size() && (s[start] == ' ' || s[start] == '\t' || s[start] == '\r' ||
+                                s[start] == '\n'))
+        ++start;
+
+    size_t end = s.size();
+    while (end > start && (s[end - 1] == ' ' || s[end - 1] == '\t' || s[end - 1] == '\r' ||
+                           s[end - 1] == '\n'))
+        --end;
+
+    return s.substr(start, end - start);
+}
+
+// SCAN_RESULTS separates its columns with tabs:
+//   bssid / frequency / signal level / flags / ssid
+std::vector<std::string> SplitTabs(const std::string& line) {
+    std::vector<std::string> cols;
+    std::string col;
+    std::istringstream stream(line);
+    while (std::getline(stream, col, '\t'))
+        cols.push_back(col);
+    return cols;
+}
+}  // namespace
+
+std::string Wlan::FindBssidForSsid(const std::string& ssid) {
+    std::string scan_results;
+    if (!SuppCmd("SCAN_RESULTS", scan_results))
+        return "";
+
+    std::string best_bssid;
+    int best_signal = -1000;
+    std::istringstream stream(scan_results);
+    std::string line;
+
+    while (std::getline(stream, line)) {
+        const std::vector<std::string> cols = SplitTabs(line);
+        if (cols.size() < 5 || DecodeSupplicantText(cols[4]) != ssid)
+            continue;
+
+        const int signal = std::atoi(TrimSpaces(cols[2]).c_str());
+        if (best_bssid.empty() || signal > best_signal) {
+            best_signal = signal;
+            best_bssid = TrimSpaces(cols[0]);
+        }
+    }
+    return best_bssid;
+}
+
+void Wlan::DumpScanResultsForSsid(const std::string& ssid) {
+    std::string scan_results;
+    if (!SuppCmd("SCAN_RESULTS", scan_results)) {
+        gui_print("WLAN: SCAN_RESULTS unavailable\n");
+        return;
+    }
+
+    bool any = false;
+    std::istringstream stream(scan_results);
+    std::string line;
+
+    while (std::getline(stream, line)) {
+        const std::vector<std::string> cols = SplitTabs(line);
+        if (cols.size() < 5 || DecodeSupplicantText(cols[4]) != ssid)
+            continue;
+        gui_print("WLAN: scan row %s\n", TrimSpaces(line).c_str());
+        any = true;
+    }
+
+    if (!any)
+        gui_print("WLAN: SSID '%s' is absent from SCAN_RESULTS\n", ssid.c_str());
+}
+
+bool Wlan::WaitForAssociation(const std::string& ssid, int tries, const char* tag) {
+    for (int attempt = 0; attempt < tries; ++attempt) {
+        std::string event;
+        const bool got_event = SuppWaitEvent({"CTRL-EVENT-CONNECTED", "CTRL-EVENT-DISCONNECTED",
+                                             "CTRL-EVENT-ASSOC-REJECT", "CTRL-EVENT-AUTH-REJECT"},
+                                            1500, event);
+
+        std::string status;
+        if (SuppCmd("STATUS", status)) {
+            std::string wpa_state;
+            std::string current_ssid;
+            std::string ip_addr;
+            ParseSupplicantStatus(status, wpa_state, current_ssid, ip_addr);
+
+            gui_print("Connection state (%s): %s (%d/%d)\n", tag, wpa_state.c_str(), attempt + 1,
+                      tries);
+
+            if (wpa_state == "COMPLETED" && current_ssid == ssid)
+                return true;
+        }
+
+        if (!got_event)
+            usleep(500 * 1000);
+    }
+    return false;
+}
+
+void Wlan::DumpDriverLog(const char* why) {
+    gui_print("WLAN: driver log (%s)\n", why);
+
+    const std::string iface = GetIface();
+    std::string operstate;
+    if (ReadFile("/sys/class/net/" + iface + "/operstate", operstate))
+        gui_print("WLAN: %s operstate=%s\n", iface.c_str(), Trim(operstate).c_str());
+
+    std::string wireless;
+    if (ReadFile("/proc/net/wireless", wireless))
+        gui_print("WLAN: /proc/net/wireless:\n%s\n", wireless.c_str());
+
+    const std::string busybox = GetBusyboxBinary();
+    if (busybox.empty()) {
+        gui_print("WLAN: no busybox, kernel ring buffer not readable\n");
+        return;
+    }
+
+    /*
+     * The supplicant runs with -dd and the cnss/qca drivers log to the kernel
+     * ring buffer, not to /tmp/recovery.log — so this is the only place the
+     * driver's own verdict about the association attempt shows up.
+     */
+    std::string dmesg;
+    if (!RunCommand(busybox + " dmesg 2>&1", dmesg)) {
+        gui_print("WLAN: dmesg unavailable (SELinux or dmesg_restrict)\n");
+        return;
+    }
+
+    static const char* keys[] = {"wlan", "cnss", "qca", "kiwi",  "cfg80211",   "wpa_supp",
+                                 "supplicant", "firmware", "bdwlan"};
+    std::vector<std::string> matched;
+    std::istringstream stream(dmesg);
+    std::string line;
+
+    while (std::getline(stream, line)) {
+        std::string lowered;
+        lowered.reserve(line.size());
+        for (size_t i = 0; i < line.size(); ++i)
+            lowered.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(line[i]))));
+
+        for (size_t i = 0; i < sizeof(keys) / sizeof(keys[0]); ++i) {
+            if (lowered.find(keys[i]) != std::string::npos) {
+                matched.push_back(line);
+                break;
+            }
+        }
+    }
+
+    const size_t keep = 40;
+    const size_t start = matched.size() > keep ? matched.size() - keep : 0;
+    for (size_t i = start; i < matched.size(); ++i)
+        gui_print("WLAN dmesg: %s\n", matched[i].c_str());
+
+    if (matched.empty())
+        gui_print("WLAN: kernel ring buffer holds no WLAN driver lines\n");
+}
+
 bool Wlan::Connect() {
     std::lock_guard<std::recursive_mutex> op(g_wlan_op_mutex);
     DataManager::SetValue("wlan_connect_text", "Connecting");
@@ -387,6 +580,24 @@ bool Wlan::Connect() {
     gui_print("Encryption: %s (key_mgmt: %s)\n", enc.c_str(), key_mgmt.c_str());
     gui_print(" \n");
 
+    /*
+     * A supplicant can only associate with a BSS it has already seen. Force a
+     * fresh scan and record whether the target shows up at all: that separates
+     * "the driver cannot join this AP" from "the driver never saw the network",
+     * which the previous flow could not tell apart.
+     */
+    gui_print("Scanning before connect...\n");
+    SuppCmd("SCAN");
+
+    std::string scan_event;
+    SuppWaitEvent({"CTRL-EVENT-SCAN-RESULTS"}, 8000, scan_event);
+
+    const std::string target_bssid = FindBssidForSsid(ssid);
+    if (target_bssid.empty())
+        gui_print("WLAN: target SSID '%s' is not visible in scan results\n", ssid.c_str());
+    else
+        gui_print("WLAN: target SSID '%s' visible on %s\n", ssid.c_str(), target_bssid.c_str());
+
     gui_print("Remove old network config...\n");
     std::string list_out;
     if (SuppCmd("LIST_NETWORKS", list_out)) {
@@ -518,6 +729,25 @@ bool Wlan::Connect() {
         }
     }
 
+    /*
+     * The device's own Android supplicant conf sets pmf=1, and a WPA3 or
+     * PMF-required AP rejects an association that never negotiated MFP. "1"
+     * means "capable", which a plain WPA2-PSK AP simply ignores.
