+// Recorded once the pre-decryption language prompt has been answered or skipped.
+// It lives in the early UI cache because the prompt runs while /data is still
+// encrypted and preferences.conf cannot be written yet.
+constexpr const char *kLanguageChosenPreference = "aera_language_chosen";
 
 bool FastbootWifiPrerequisites() {
 #ifdef OF_ENABLE_WLAN
@@ -2135,6 +2140,23 @@ bool RecoverySetLanguage(const std::string &language) {
   }
   return DataManager::SetValue("tw_language", language, 1) == 0;
 }
+bool RecoveryLanguageChosen() {
+  LoadAeraPreferencesIfAvailable();
+  return DataManager::GetIntValue(kLanguageChosenPreference) != 0;
+}
+bool RecoveryMarkLanguageChosen() {
+  const int previous = DataManager::GetIntValue(kLanguageChosenPreference);
+  if (DataManager::SetValue(kLanguageChosenPreference, 1, 1) != 0) return false;
+  // This runs while /data is still locked, so SaveAeraPreferences() would return
+  // before reaching its own early-cache write: refresh the cache directly.
+  const bool early_saved = SaveEarlyUiPreferences();
+  // No-op before decryption and the normal refresh afterwards, once /data is
+  // available, so the full preferences file also carries the record.
+  SaveAeraPreferences();
+  if (early_saved) return true;
+  DataManager::SetValue(kLanguageChosenPreference, previous, 1);
+  return false;
+}
