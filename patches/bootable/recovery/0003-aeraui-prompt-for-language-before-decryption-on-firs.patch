+    // protections (Back stays off the home screen while either one is up).
     decryption_active_ = true;
     secondary_decryption_ = false;
     credential_type_ = credential_type;
@@ -748,14 +750,44 @@ public:
     ApplyStoredAppearance();
     lv_obj_t *boot_screen = lv_screen_active();
     CompleteBootScene(boot_screen);
+#ifdef AERA_FIRST_BOOT_LANGUAGE
+    if (OfferFirstBootLanguage(file_based, pattern_grid_size)) return;
+#endif
+    ShowDecryptScene(file_based, pattern_grid_size);
+  }
+
+  // Builds the credential page. The opt-in first-boot language prompt is shown
+  // before this runs, so both paths share one construction.
+  void ShowDecryptScene(bool file_based, int pattern_grid_size) {
     lv_obj_t *decrypt = lv_obj_create(nullptr);
     decrypt_scene_ = BuildDecryptScene(
-        decrypt, credential_type, file_based, user_id, pattern_grid_size,
-        HandleSceneAction, this);
+        decrypt, credential_type_, file_based, crypto_user_id_,
+        pattern_grid_size, HandleSceneAction, this);
     on_home_ = false;
     lv_screen_load_anim(decrypt, LV_SCR_LOAD_ANIM_FADE_IN, 820, 0, true);
   }
 
+#ifdef AERA_FIRST_BOOT_LANGUAGE
+  // Returns true when the language prompt took over the screen. Every other
+  // outcome - a single-language build, a recorded choice, or no screen - returns
+  // false and decryption proceeds exactly as it does today.
+  bool OfferFirstBootLanguage(bool file_based, int pattern_grid_size) {
+    if (i18n::AvailableLanguages().size() < 2) return false;
+    if (RecoveryLanguageChosen()) return false;
+    lv_obj_t *language = lv_obj_create(nullptr);
+    if (language == nullptr) return false;
+    pending_file_based_ = file_based;
+    pending_pattern_grid_size_ = pattern_grid_size;
+    BuildFirstBootLanguageScene(language, HandleSceneAction, this);
+    lv_screen_load_anim(language, LV_SCR_LOAD_ANIM_FADE_IN, 820, 0, true);
+    return true;
+  }
+
+  void ContinueAfterFirstBootLanguage() {
+    ShowDecryptScene(pending_file_based_, pending_pattern_grid_size_);
+  }
+#endif
+
   void SetBackendReady() {
     if (backend_ready_)
       return;
@@ -2443,6 +2475,15 @@ private:
       return;
     }
 
+#ifdef AERA_FIRST_BOOT_LANGUAGE
+    // Dispatched before the decryption gate below: the prompt runs while
+    // decryption_active_ is set but no decrypt scene exists yet.
+    if (action == Action::kFirstBootLanguageDone) {
+      self->ContinueAfterFirstBootLanguage();
+      return;
+    }
+#endif
+
     if (self->decryption_active_) {
       if (action == Action::kDecryptSubmit) {
         self->StartDecryption();
@@ -3900,6 +3941,11 @@ private:
