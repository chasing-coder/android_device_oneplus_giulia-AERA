diff --git a/aeraui/build/aeraui_defaults.go b/aeraui/build/aeraui_defaults.go
index 9660a02..ce4571f 100644
--- a/aeraui/build/aeraui_defaults.go
+++ b/aeraui/build/aeraui_defaults.go
@@ -80,6 +80,12 @@ func aeraUiLanguageFlags(ctx android.BaseContext) []string {
 	if getMakeVars(ctx, "AERA_EXTRA_LANGUAGES") == "true" {
 		cflags = append(cflags, "-DAERA_EXTRA_LANGUAGES=1")
 	}
+	// Opt-in pre-decryption language prompt. Off unless the device tree asks for
+	// it, so a build without the switch keeps today's behaviour.
+	firstBootLanguage := strings.Trim(getMakeVars(ctx, "AERA_FIRST_BOOT_LANGUAGE"), "\"")
+	if firstBootLanguage == "1" || strings.EqualFold(firstBootLanguage, "true") {
+		cflags = append(cflags, "-DAERA_FIRST_BOOT_LANGUAGE=1")
+	}
 	return cflags
 }
 
