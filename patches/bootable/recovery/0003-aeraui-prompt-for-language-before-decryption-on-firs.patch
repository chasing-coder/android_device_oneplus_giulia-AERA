index 0000000..e8e327b
--- /dev/null
+++ b/aeraui/scenes/first_boot_language_scene.cpp
@@ -0,0 +1,95 @@
+/*
+ * Copyright (C) 2026 AERA Recovery Project contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "scene.hpp"
+#include "ui_components.hpp"
+
+#include <algorithm>
+#include <string>
+
+#include <lvgl.h>
+
+#include "design.hpp"
+#include "aeraui/i18n.hpp"
+
+namespace aeraui {
+namespace {
+using namespace widgets;
+using namespace design;
+
+// The prompt runs before decryption, so it owns no navigation and no
+// status-bar shade: choosing a language, or skipping, is the only way forward.
+void ContinueToDecryption(ActionCallback callback, void *context) {
+  if (callback != nullptr) callback(Action::kFirstBootLanguageDone, context);
+}
+
+}  // namespace
+
+void BuildFirstBootLanguageScene(lv_obj_t *screen, ActionCallback callback,
+                                 void *context) {
+  // Static bilingual copy on purpose: the chooser cannot depend on a catalog
+  // entry, because the catalog is what the user is about to select.
+  Header(screen, "Language / 语言", "Choose a language / 选择语言", nullptr,
+         nullptr);
+  const bool landscape = Landscape(screen);
+  const int top = landscape ? 340 : 452;
+  // Room for the skip button below the list.
+  const int footer = 176;
+  lv_obj_t *list = Scroll(
+      screen, top,
+      std::max(1, static_cast<int>(lv_obj_get_height(screen)) - top - footer));
+  lv_obj_set_scrollbar_mode(list, LV_SCROLLBAR_MODE_ON);
+  lv_obj_set_style_width(list, 14, LV_PART_SCROLLBAR);
+  lv_obj_set_style_bg_opa(list, LV_OPA_COVER, LV_PART_SCROLLBAR);
+  lv_obj_set_style_radius(list, LV_RADIUS_CIRCLE, LV_PART_SCROLLBAR);
+  lv_obj_update_layout(list);
+  const int row_width =
+      std::max(600, static_cast<int>(lv_obj_get_width(list)) - 28);
+  const auto &languages = i18n::AvailableLanguages();
+  for (size_t i = 0; i < languages.size(); ++i) {
+    const auto language = languages[i];
+    const bool selected = std::string(i18n::CurrentLanguage()) == language.code;
+    auto *row = Button(list, "", [] {}, selected);
+    lv_obj_set_pos(row, 0, static_cast<int>(i) * 154);
+    lv_obj_set_size(row, row_width, 142);
+    lv_obj_set_style_radius(row, 22, 0);
+    auto *native =
+        Label(row, language.native_name, &lv_font_montserrat_32, kText);
+    lv_obj_set_pos(native, 28, 20);
+    lv_obj_set_width(native, row_width - 180);
+    lv_label_set_long_mode(native, LV_LABEL_LONG_MODE_DOTS);
+    auto *english = Label(row, language.name, &lv_font_montserrat_24, kMuted);
+    lv_obj_set_pos(english, 30, 80);
+    lv_obj_set_width(english, row_width - 180);
+    lv_label_set_long_mode(english, LV_LABEL_LONG_MODE_DOTS);
+    if (selected) {
+      auto *check = Label(row, LV_SYMBOL_OK, &lv_font_montserrat_32, kAccent);
+      lv_obj_align(check, LV_ALIGN_RIGHT_MID, -38, 0);
+    }
+    OnClick(row, [screen, callback, context, language] {
+      // Never block decryption on a preference: a language this build cannot
+      // apply still continues with the one it already had.
+      if (RecoverySetLanguage(language.code)) {
+        i18n::SetLanguage(language.code);
+        RecoveryMarkLanguageChosen();
+        // ApplyDirection reads IsRightToLeft(), so a single call settles both
+        // directions before the decrypt page is built.
+        i18n::ApplyDirection(screen);
+      }
+      ContinueToDecryption(callback, context);
+    });
+  }
+  auto *skip = Button(screen, "Skip / 跳过", [callback, context] {
+    // Skipping is an answer too. Without the record the prompt would return on
+    // every boot, and the build keeps AERA_DEFAULT_LANGUAGE.
+    RecoveryMarkLanguageChosen();
+    ContinueToDecryption(callback, context);
+  });
+  lv_obj_set_pos(skip, 64,
+                 static_cast<int>(lv_obj_get_height(screen)) - footer + 20);
+  lv_obj_set_size(skip, row_width, 128);
+}
+
+}  // namespace aeraui
