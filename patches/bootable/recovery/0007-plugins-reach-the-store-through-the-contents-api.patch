+// The GitHub contents API answers with the file base64 encoded inside a JSON
+// envelope, and recovery can reach api.github.com where raw.githubusercontent.com
+// is filtered - this is the same host the AERA root manager updates through.
+bool Base64Decode(const std::string &text, std::string &decoded) {
+  static constexpr char kAlphabet[] =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  int table[256];
+  for (int i = 0; i < 256; ++i) table[i] = -1;
+  for (int i = 0; i < 64; ++i) table[static_cast<unsigned char>(kAlphabet[i])] = i;
+  decoded.clear();
+  decoded.reserve(text.size() * 3 / 4);
+  uint32_t buffer = 0;
+  unsigned bits = 0;
+  for (unsigned char c : text) {
+    if (c == '=' || std::isspace(c)) continue;
+    const int value = table[c];
+    if (value < 0) return false;
+    buffer = (buffer << 6) | static_cast<uint32_t>(value);
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      decoded.push_back(static_cast<char>((buffer >> bits) & 0xff));
+    }
+  }
+  return !decoded.empty() && bits < 8;
+}
+
+// Fetch one file through the contents API and leave its decoded bytes in path.
+bool DownloadApiContents(const std::string &url, const std::string &path,
+                         uint64_t limit, Progress *progress, unsigned start,
+                         unsigned end) {
+  const std::string envelope = std::string(kCacheRoot) + "/api.json";
+  const uint64_t envelope_limit = limit * 2 + 65536;
+  const bool fetched =
+      DownloadOnce(url, envelope, envelope_limit, progress, start, end, 0);
+  std::string text;
+  const bool read_ok = fetched && ReadBounded(envelope, envelope_limit, text);
+  unlink(envelope.c_str());
+  Json::Value root;
+  if (!read_ok || !ParseJson(text, root) || !root.isObject()) {
+    fprintf(stderr, "AERA plugins: contents API %s failed (download=%d, %zu B)\n",
+            HostOf(url).c_str(), fetched ? 1 : 0, text.size());
+    return false;
+  }
+  const std::string encoded = root.get("content", "").asString();
+  std::string decoded;
+  const bool decoded_ok = !encoded.empty() && Base64Decode(encoded, decoded) &&
+                          decoded.size() <= limit;
+  if (!decoded_ok) {
+    fprintf(stderr,
+            "AERA plugins: contents API %s has no usable content (%zu B, "
+            "encoding=%s, message=\"%s\")\n",
+            HostOf(url).c_str(), encoded.size(),
+            root.get("encoding", "").asString().c_str(),
+            PrintablePrefix(root.get("message", "").asString(), 60).c_str());
+    return false;
+  }
+  unlink(path.c_str());
+  return WriteFile(path, decoded);
+}
+
+// Derive the contents-API address of a raw file in the AERA-Plugins org, so the
+// same bytes can be fetched from api.github.com when raw.githubusercontent.com
+// is filtered. Owner, ref and path are preserved exactly.
+bool ApiContentsUrl(const std::string &raw_url, std::string &api_url) {
+  constexpr char prefix[] = "https://raw.githubusercontent.com/AERA-Plugins/";
+  if (raw_url.compare(0, sizeof(prefix) - 1, prefix) != 0) return false;
+  const std::string rest = raw_url.substr(sizeof(prefix) - 1);
+  const size_t repo_end = rest.find('/');
+  const size_t ref_end = repo_end == std::string::npos
+                             ? std::string::npos
+                             : rest.find('/', repo_end + 1);
+  if (repo_end == std::string::npos || ref_end == std::string::npos) return false;
+  const std::string repo = rest.substr(0, repo_end);
+  const std::string ref = rest.substr(repo_end + 1, ref_end - repo_end - 1);
+  const std::string path = rest.substr(ref_end + 1);
+  if (repo.empty() || ref.empty() || path.empty()) return false;
+  api_url = "https://api.github.com/repos/AERA-Plugins/" + repo + "/contents/" +
+            path + "?ref=" + ref;
+  return true;
+}
+
+// Try every source for one file: the contents API first (the only host the root
+// manager proves reachable from recovery), then a public mirror, then GitHub
+// itself. Whatever arrives still has to pass the caller's signature or SHA-256
+// check, so a mirror or a proxy can only ever supply identical bytes.
+bool Download(const std::string &url, const std::string &path, uint64_t limit,
+              Progress *progress = nullptr, unsigned progress_start = 0,
+              unsigned progress_end = 0, uint64_t expected_size = 0) {
+  if (!OfficialUrl(url) || limit == 0 || limit > kMaxPayload) return false;
+  struct Candidate {
+    std::string url;
+    bool contents_api;
+  };
+  std::vector<Candidate> candidates;
+  std::string api_url;
+  if (ApiContentsUrl(url, api_url)) candidates.push_back({api_url, true});
+  std::vector<std::string> mirrors;
+  AppendMirrors(url, mirrors);
+  for (const auto &mirror : mirrors) candidates.push_back({mirror, false});
+  candidates.push_back({url, false});
+  for (size_t index = 0; index < candidates.size(); ++index) {
+    if (progress && progress->cancel.load()) break;
+    const Candidate &candidate = candidates[index];
+    const bool ok = candidate.contents_api
+        ? DownloadApiContents(candidate.url, path, limit, progress,
+                              progress_start, progress_end)
+        : DownloadOnce(candidate.url, path, limit, progress, progress_start,
+                       progress_end, expected_size);
+    if (ok) {
+      if (HostOf(candidate.url) != HostOf(url)) {
+        fprintf(stderr, "AERA plugins: %s delivered by %s\n", url.c_str(),
+                HostOf(candidate.url).c_str());
+      }
+      return true;
+    }
+    if (index + 1 < candidates.size()) {
+      fprintf(stderr, "AERA plugins: %s unavailable, trying %s\n", url.c_str(),
+              HostOf(candidates[index + 1].url).c_str());
+    }
+  }
+  fprintf(stderr, "AERA plugins: no source could deliver %s\n", url.c_str());
+  return false;
+}
